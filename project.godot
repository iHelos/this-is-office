; This Is the Office — Godot 4 project.
;
; A corporate reimagining of "This Is the Police": you are an office manager
; given 180 working days by the CTO to hit a profit target while keeping the
; team together through a war between rival departments.
;
; Rendering and display mirror the zpg conventions: GL Compatibility renderer,
; nearest-neighbour textures (the office is drawn as crisp isometric tiles), and
; a 1280x800 window that keeps a 1:1 aspect on Steam Deck. See docs/architecture.md.

config_version=5

[application]

config/name="This Is the Office"
config/description="A corporate reimagining of This Is the Police. Deterministic simulation, 180 days to hit the target."
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Game="*res://autoload/game.gd"
L10n="*res://autoload/l10n.gd"

[debug]

; Static typing is mandatory everywhere, the same way it is in zpg. Untyped
; declarations and unsafe property access are warnings, not silent.
gdscript/warnings/untyped_declaration=1
gdscript/warnings/unsafe_property_access=1

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[internationalization]

; Russian is the native language of the project; English ships alongside from
; day one so the localization seams are exercised by every screen. Translations
; are registered in code by autoload/l10n.gd (see comment there for why), so the
; project file intentionally does not list translation resources.
locale/test_key_ordering=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
anti_aliasing/quality/msaa_2d=0
